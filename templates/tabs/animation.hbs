<section class="tab standard-form {{tab.cssClass}}" data-group="primary" data-tab="animation">
  <div class="form-group">
    <label>{{localize "FADECUE.Editor.AnimationTypeLabel"}}</label>
    <div class="form-fields">
      <select name="animationType">
        {{selectOptions animationTypes selected=transition.animationType}}
      </select>
    </div>
  </div>

  <div class="form-group fade-and-cue-direction">
    <label>{{localize "FADECUE.Editor.DirectionLabel"}}</label>
    <div class="form-fields">
      <select name="direction">
        {{selectOptions directions selected=transition.direction}}
      </select>
    </div>
  </div>
</section>
