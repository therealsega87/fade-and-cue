<header class="directory-header flexcol">
  <div class="header-actions action-buttons flexrow">
    <button type="button" data-action="create">
      <i class="fa-solid fa-plus"></i> {{localize "FADECUE.Directory.NewButton"}}
    </button>
    <button type="button" data-action="import">
      <i class="fa-solid fa-file-import"></i> {{localize "FADECUE.Io.ImportButton"}}
    </button>
  </div>
  <search>
    <input type="search" name="search" autocomplete="off"
      placeholder="{{localize 'FADECUE.Sidebar.SearchPlaceholder'}}"
      aria-label="{{localize 'FADECUE.Sidebar.SearchPlaceholder'}}">
  </search>
</header>
