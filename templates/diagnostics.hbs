<section class="fade-and-cue-diagnostics-body">
  <p class="hint">{{localize "FADECUE.Diagnostics.Intro"}}</p>
  <textarea readonly spellcheck="false">{{text}}</textarea>
  <div class="form-footer">
    <button type="button" data-action="copy"><i class="fa-solid fa-copy"></i> {{localize "FADECUE.Diagnostics.Copy"}}</button>
    <button type="button" data-action="download"><i class="fa-solid fa-download"></i> {{localize "FADECUE.Diagnostics.Download"}}</button>
    <button type="button" data-action="playback"><i class="fa-solid fa-play"></i> {{localize "FADECUE.Diagnostics.Playback"}}</button>
    <button type="button" data-action="rerun"><i class="fa-solid fa-rotate"></i> {{localize "FADECUE.Diagnostics.Rerun"}}</button>
  </div>
</section>
